  <script>
    const neutralRegionNames = {
      "Egypt": "جمهورية مصر والوادي", "United States of America": "الولايات المتحدة الأمريكية",
      "China": "جمهورية الصين الشعبية", "Russia": "الاتحاد الروسي", "France": "الجمهورية الفرنسية",
      "Germany": "جمهورية ألمانيا الاتحادية", "Saudi Arabia": "المملكة العربية السعودية",
      "Algeria": "الجمهورية الجزائرية", "Brazil": "جمهورية البرازيل الاتحادية", "India": "جمهورية الهند"
    };

    const state = {
      isSetupMode: true, pendingSelection: null, authMode: 'login',
      leaderName: "الجنرال", nationName: "الجمهورية الكبرى",
      rubies: 50, playerLat: 26.8, playerLng: 30.8, budget: 500000,
      uncollectedTaxes: 0, steel: 100, concrete: 100, wood: 100, oil: 200, uranium: 10,
      missiles: 2, infantry: 500, warships: 1, army: 900,
      level: 1, exp: 0, expToNextLevel: 300,
      factories: { wood: 1, concrete: 1, steel: 1, uranium: 0, airDefense: 0 },
      activeConstructions: [], newsArchive: [], relations: {}, countryLayers: {}, selectedCountry: null
    };

    let map;

    const playSFX = (freq = 440, type = 'sine', duration = 0.15) => {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.04, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(); osc.stop(ctx.currentTime + duration);
      } catch (e) {}
    };

    function showToast(title, message, type = 'info') {
      if (!state.newsArchive) state.newsArchive = [];
      const timeStr = new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
      state.newsArchive.unshift({ title, message, type, time: timeStr });
      const badge = document.getElementById('newspaper-badge');
      if (badge) { badge.innerText = state.newsArchive.length; badge.classList.remove('hidden'); }
      playSFX(750, 'sine', 0.2);
    }

    function toggleNewspaperPanel() {
      const modal = document.getElementById('newspaper-modal');
      if (modal.classList.contains('hidden')) { renderNewspaperFeed(); modal.classList.remove('hidden'); modal.classList.add('flex'); }
      else { modal.classList.add('hidden'); modal.classList.remove('flex'); }
    }

    function renderNewspaperFeed() {
      const feedList = document.getElementById('newspaper-feed-list');
      if (!feedList) return;
      if (!state.newsArchive || state.newsArchive.length === 0) {
        feedList.innerHTML = `<div class="text-center py-10 text-slate-400 font-bold text-xs">لا توجد أخبار مسجلة حالياً...</div>`;
        return;
      }
      feedList.innerHTML = state.newsArchive.map(news => `
        <div class="glass-hud p-4 rounded-2xl border border-amber-500/30 bg-slate-900/90 text-right space-y-1">
          <div class="flex justify-between text-[10px] text-amber-400 font-bold"><span>${news.title}</span><span>${news.time}</span></div>
          <p class="text-xs text-slate-200">${news.message}</p>
        </div>
      `).join('');
    }

    function handleAuthSubmit() {
      const username = document.getElementById('auth-username').value.trim();
      if (!username) return showToast("تنبيه", "أدخل اسم القائد!", "warning");
      state.leaderName = username;
      document.getElementById('auth-modal').classList.add('hidden');
      if (state.isSetupMode) document.getElementById('setup-banner').classList.remove('hidden');
      else {
        document.getElementById('hud-layer').classList.remove('hidden');
        document.getElementById('tax-collector-btn').classList.remove('hidden');
        updateHUD();
      }
    }

    async function initMap() {
      map = L.map('map', { center: [20.0, 15.0], zoom: 3, zoomControl: true, attributionControl: false });
      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 17, minZoom: 2 }).addTo(map);

      map.on('click', () => { hideRadialMenu(); deselectCountryInspector(); });

      try {
        const response = await fetch('https://raw.githubusercontent.com/johan/world.geo.json/master/countries.geo.json');
        const geojsonData = await response.json();
        L.geoJSON(geojsonData, {
          style: (feature) => getCountryStyle(feature),
          onEachFeature: (feature, layer) => {
            const metrics = calculateCountryMetrics(feature);
            state.countryLayers[metrics.name] = { layer, feature, metrics };
            layer.on({ click: (e) => { L.DomEvent.stopPropagation(e); handleCountryClick(feature, layer, e.latlng); } });
          }
        }).addTo(map);
      } catch (err) {}
    }

    function getCountryStyle(feature) {
      const origName = feature.properties.name || "إقليم";
      const neutralName = neutralRegionNames[origName] || `إقليم ${origName}`;
      if (neutralName === state.nationName) return { fillColor: '#10b981', weight: 2.5, opacity: 0.9, color: '#34d399', fillOpacity: 0.5 };
      return { fillColor: '#0284c7', weight: 1.2, opacity: 0.7, color: '#38bdf8', fillOpacity: 0.2 };
    }

    function calculateCountryMetrics(feature) {
      const origName = feature.properties.name || "إقليم";
      const neutralName = neutralRegionNames[origName] || `إقليم ${origName}`;
      let hash = 0; for (let i = 0; i < origName.length; i++) hash = origName.charCodeAt(i) + ((hash << 5) - hash);
      hash = Math.abs(hash);
      const population = Math.floor((hash % 60000000) + 5000000);
      const bounds = feature.geometry.type === "Polygon" ? feature.geometry.coordinates[0] : feature.geometry.coordinates[0][0];
      const sampleLng = bounds[0][0], sampleLat = bounds[0][1];
      return { name: neutralName, population: population.toLocaleString('ar-EG'), gdp: '$' + (population * 8).toLocaleString(), military: (Math.floor(population * 0.003) + 200).toLocaleString('ar-EG'), lat: sampleLat, lng: sampleLng };
    }

    function handleCountryClick(feature, layer, latlng) {
      const metrics = calculateCountryMetrics(feature);
      if (state.isSetupMode) {
        state.pendingSelection = { feature, layer, metrics };
        document.getElementById('setup-selected-country-text').innerText = `لقد اخترت: ${metrics.name}`;
        document.getElementById('setup-country-name').value = metrics.name;
        document.getElementById('setup-modal').classList.remove('hidden'); document.getElementById('setup-modal').classList.add('flex');
      } else {
        state.selectedCountry = metrics;
        inspectCountry(metrics);
        showRadialMenu(latlng, metrics);
      }
    }

    function inspectCountry(metrics) {
      document.getElementById('country-inspector').classList.remove('hidden');
      document.getElementById('inspect-country-name').innerText = metrics.name;
      document.getElementById('inspect-pop').innerText = metrics.population;
      document.getElementById('inspect-gdp').innerText = metrics.gdp;
      document.getElementById('inspect-military').innerText = metrics.military;
    }

    function deselectCountryInspector() {
      state.selectedCountry = null;
      document.getElementById('country-inspector').classList.add('hidden');
    }

    function showRadialMenu(latlng, metrics) {
      const menu = document.getElementById('radial-menu');
      const point = map.latLngToContainerPoint(latlng);
      menu.style.left = `${point.x}px`; menu.style.top = `${point.y}px`;
      document.getElementById('radial-country-name').innerText = metrics.name;
      menu.classList.remove('hidden');
    }

    function hideRadialMenu() { document.getElementById('radial-menu').classList.add('hidden'); }

    function radialAction(actionType) {
      hideRadialMenu();
      if (actionType === 'attack') openAttackModal();
      if (actionType === 'diplomacy') openHelpModal();
      if (actionType === 'trade') openMarketModal();
      if (actionType === 'base') openEspionageModal();
    }

    function confirmSetup() {
      if (!state.pendingSelection) return;
      const { metrics } = state.pendingSelection;
      state.nationName = document.getElementById('setup-country-name').value.trim() || metrics.name;
      state.playerLat = metrics.lat; state.playerLng = metrics.lng;
      state.isSetupMode = false;
      document.getElementById('setup-banner').classList.add('hidden');
      document.getElementById('setup-modal').classList.add('hidden');
      document.getElementById('hud-layer').classList.remove('hidden');
      document.getElementById('tax-collector-btn').classList.remove('hidden');
      document.getElementById('hud-nation-name').innerText = state.nationName;
      updateHUD();
      showToast("El-General", `تم توليك مقاليد الحكم في ${state.nationName}!`, "success");
    }

    function cancelSetupSelection() { document.getElementById('setup-modal').classList.add('hidden'); }

    /* ANIMATED ATTACK ON MAP */
    function executeAnimatedAttack() {
      closeAttackModal();
      if (!state.selectedCountry) return showToast("تنبيه", "حدد الدولة المستهدفة أولاً!", "warning");
      
      const targetLat = state.selectedCountry.lat;
      const targetLng = state.selectedCountry.lng;
      
      // Draw Attack Curved Polyline
      const latlngs = [
        [state.playerLat, state.playerLng],
        [(state.playerLat + targetLat) / 2 + 5, (state.playerLng + targetLng) / 2],
        [targetLat, targetLng]
      ];
      
      const polyline = L.polyline(latlngs, { color: '#ef4444', weight: 3, opacity: 0.8, className: 'attack-line' }).addTo(map);
      playSFX(200, 'sawtooth', 0.5);
      showToast("انطلاق الهجوم", `انطلقت الصواريخ والقوات القتالية نحو ${state.selectedCountry.name}!`, "danger");

      setTimeout(() => {
        map.removeLayer(polyline);
        showToast("انتصار ميداني", `تم إصابة الأهداف في ${state.selectedCountry.name} بنجاح وتدمير البنية التحتية للعدو!`, "success");
      }, 3000);
    }

    function sendAidWithVisualLine() {
      closeHelpModal();
      if (!state.selectedCountry) return;
      state.budget -= 50000;
      updateHUD();
      showToast("مساعدات خارجية", `تم تحويل 50,000$ لدولة ${state.selectedCountry.name}!`, "success");
    }

    function tradeResource(type, mode, price) {
      if (mode === 'buy') {
        if (state.budget < price) return showToast("خطأ", "الميزانية غير كافية!", "danger");
        state.budget -= price; state[type] += 1;
      } else {
        if (state[type] <= 0) return showToast("خطأ", "لا تملك رصيد من هذا المورد!", "warning");
        state[type] -= 1; state.budget += price;
      }
      updateHUD();
    }

    function upgradeBuilding(type, cost) {
      if (state.budget < cost) return showToast("نقص مال", "الميزانية غير كافية!", "danger");
      state.budget -= cost;
      state.factories[type] = (state.factories[type] || 0) + 1;
      const el = document.getElementById(`lvl-${type}`);
      if (el) el.innerText = state.factories[type];
      updateHUD();
      showToast("تم التطوير", `تم رفع مستوى مبنى ${type}!`, "success");
    }

    function upgradeAirDefense() {
      if (state.budget < 300000) return showToast("نقص مال", "الميزانية غير كافية!", "danger");
      state.budget -= 300000;
      state.factories.airDefense = (state.factories.airDefense || 0) + 1;
      document.getElementById('lvl-airdef').innerText = state.factories.airDefense;
      updateHUD();
      showToast("تحديث دفاعي", "تم تركيب شبكة دفاع جوي S-400 جديدة!", "success");
    }

    function openTaxCollectorBanner() {
      document.getElementById('tax-collector-total-text').innerText = '$' + state.uncollectedTaxes.toLocaleString();
      document.getElementById('tax-slider').max = state.uncollectedTaxes;
      document.getElementById('tax-slider').value = state.uncollectedTaxes;
      document.getElementById('tax-custom-input').value = state.uncollectedTaxes;
      document.getElementById('tax-collector-modal').classList.remove('hidden'); document.getElementById('tax-collector-modal').classList.add('flex');
    }
    function closeTaxCollectorBanner() { document.getElementById('tax-collector-modal').classList.add('hidden'); }
    function syncTaxSliderValue(val) { document.getElementById('tax-custom-input').value = val; }
    function syncTaxInputValue(val) { document.getElementById('tax-slider').value = Math.min(val, state.uncollectedTaxes); }
    function confirmCollectTaxes() {
      const amount = parseInt(document.getElementById('tax-custom-input').value) || 0;
      state.uncollectedTaxes -= amount; state.budget += amount;
      closeTaxCollectorBanner(); updateHUD();
      showToast("توريد الخزينة", `تم جمع $${amount.toLocaleString()}!`, "success");
    }

    function produceTacticalMissiles() {
      if (state.budget < 100000 || state.steel < 50) return showToast("نقص موارد", "تحتاج 100,000$ و50 صلب!", "danger");
      state.budget -= 100000; state.steel -= 50; state.missiles += 1;
      updateHUD(); showToast("إنتاج ترسانة", "تم إنتاج صاروخ تكتيكي!", "success");
    }

    function recruitWarships() {
      if (state.budget < 150000) return showToast("نقص مال", "الميزانية غير كافية!", "danger");
      state.budget -= 150000; state.warships += 1;
      updateHUD(); showToast("الأسطول البحري", "تم تدشين سفينة حربية جديدة!", "success");
    }

    function executeSpyMission(type) { closeEspionageModal(); showToast("جهاز الاستخبارات", "تم إرسال فريق الجاسوسية لتنفيذ المهمة!", "info"); }
    function researchTech(type, cost) { if (state.budget >= cost) { state.budget -= cost; updateHUD(); showToast("أبحاث", "تم إنهاء تطوير البحث العلمي!", "success"); closeTechModal(); } }

    function openProductionPage() { document.getElementById('production-modal').classList.remove('hidden'); document.getElementById('production-modal').classList.add('flex'); }
    function closeProductionPage() { document.getElementById('production-modal').classList.add('hidden'); }
    function openMilitaryModal() { document.getElementById('military-modal').classList.remove('hidden'); document.getElementById('military-modal').classList.add('flex'); }
    function closeMilitaryModal() { document.getElementById('military-modal').classList.add('hidden'); }
    function openAttackModal() { document.getElementById('attack-modal').classList.remove('hidden'); document.getElementById('attack-modal').classList.add('flex'); }
    function closeAttackModal() { document.getElementById('attack-modal').classList.add('hidden'); }
    function openHelpModal() { document.getElementById('help-modal').classList.remove('hidden'); document.getElementById('help-modal').classList.add('flex'); }
    function closeHelpModal() { document.getElementById('help-modal').classList.add('hidden'); }
    function openEspionageModal() { document.getElementById('espionage-modal').classList.remove('hidden'); document.getElementById('espionage-modal').classList.add('flex'); }
    function closeEspionageModal() { document.getElementById('espionage-modal').classList.add('hidden'); }
    function openTechModal() { document.getElementById('tech-modal').classList.remove('hidden'); document.getElementById('tech-modal').classList.add('flex'); }
    function closeTechModal() { document.getElementById('tech-modal').classList.add('hidden'); }
    function openMarketModal() { document.getElementById('market-modal').classList.remove('hidden'); document.getElementById('market-modal').classList.add('flex'); }
    function closeMarketModal() { document.getElementById('market-modal').classList.add('hidden'); }

    function updateHUD() {
      state.army = state.infantry + (state.warships * 400);
      document.getElementById('hud-level').innerText = `Lvl ${state.level}`;
      document.getElementById('hud-rubies').innerText = `${state.rubies} 💎`;
      document.getElementById('hud-budget').innerText = '$' + state.budget.toLocaleString();
      document.getElementById('hud-steel').innerText = state.steel + ' طن';
      document.getElementById('hud-concrete').innerText = state.concrete + ' طن';
      document.getElementById('hud-wood').innerText = state.wood + ' طن';
      document.getElementById('hud-uranium').innerText = state.uranium + ' كجم';
      document.getElementById('hud-oil').innerText = state.oil + ' برميل';
      document.getElementById('hud-missiles').innerText = state.missiles;
      document.getElementById('hud-army').innerText = state.army.toLocaleString();
      document.getElementById('tax-btn-amount').innerText = '$' + state.uncollectedTaxes.toLocaleString();
    }

    // GAME LOOP & DYNAMIC EVENTS
    setInterval(() => {
      if (state.isSetupMode) return;
      state.uncollectedTaxes += 2500;
      state.wood += state.factories.wood;
      state.concrete += state.factories.concrete;
      state.steel += state.factories.steel;
      if (state.factories.uranium > 0) state.uranium += state.factories.uranium;
      updateHUD();
    }, 1000);

    // Random Crises Event (Every 45 sec)
    setInterval(() => {
      if (state.isSetupMode) return;
      const events = [
        "أزمة طاقة عالمية: ارتفعت أسعار النفط في السوق الدولي!",
        "اكتشاف منجم يورانيوم جديد في أطراف الدولة!",
        "زلازل خفيفة تتسبب بأضرار بسيطة في المصانع القومية."
      ];
      const selected = events[Math.floor(Math.random() * events.length)];
      showToast("حدث عالمي عاجل", selected, "warning");
    }, 45000);

    window.onload = () => { initMap(); };
  </script>
</body>
</html>
